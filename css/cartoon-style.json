{
  "version": 8,
  "name": "Tokyo Quest Cartoon",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors © <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> © <a href=\"https://openfreemap.org\">OpenFreeMap</a>"
    },
    "wash": {
      "type": "geojson",
      "data": {
        "type": "Feature",
        "geometry": {
          "type": "Polygon",
          "coordinates": [[[139.50, 35.55], [139.90, 35.55], [139.90, 35.78], [139.50, 35.78], [139.50, 35.55]]]
        }
      }
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f6efe4" } },
    {
      "id": "residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#ffe8f0", "fill-opacity": 0.9 }
    },
    {
      "id": "wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#b7d7a8" }
    },
    {
      "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#a9d4a4" }
    },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#9fd4f2" }
    },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#7ec4ea",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 3, 18, 6]
      }
    },
    {
      "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "paint": { "fill-color": "#fff", "fill-outline-color": "#f3b7cc" }
    },
    {
      "id": "path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f3d2b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 17, 2.4]
      }
    },
    {
      "id": "minor-case", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f7c3d4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1.4, 16, 6, 18, 12]
      }
    },
    {
      "id": "minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fffaf6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.8, 16, 3.6, 18, 8]
      }
    },
    {
      "id": "major-case", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f28aaa",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2, 15, 8, 18, 16]
      }
    },
    {
      "id": "major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 15, 5, 18, 11]
      }
    },
    {
      "id": "motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe08a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.2, 14, 5, 17, 12]
      }
    },
    {
      "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#d7a8c4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 2.5],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "dusk-wash", "type": "fill", "source": "wash",
      "paint": { "fill-color": "#e7a15a", "fill-opacity": 0 }
    },
    {
      "id": "night-wash", "type": "fill", "source": "wash",
      "paint": { "fill-color": "#2a3148", "fill-opacity": 0 }
    },
    {
      "id": "road-major", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["case",
          ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name:ja"], ["get", "name"], ""]]],
          ["concat", ["coalesce", ["get", "name:ja"], ["get", "name"]], "  ", ["get", "name:en"]],
          ["coalesce", ["get", "name:ja"], ["get", "name"], ["get", "name:en"], ""]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 11, 16, 14, 18, 16],
        "text-max-angle": 28,
        "text-padding": 8,
        "symbol-spacing": 380,
        "text-rotation-alignment": "map",
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#6d4452",
        "text-halo-color": "#fffaf4",
        "text-halo-width": 1.6,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "road-minor", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["tertiary", "minor", "service"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["case",
          ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name:ja"], ["get", "name"], ""]]],
          ["concat", ["coalesce", ["get", "name:ja"], ["get", "name"]], "  ", ["get", "name:en"]],
          ["coalesce", ["get", "name:ja"], ["get", "name"], ["get", "name:en"], ""]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 10, 17, 13],
        "text-max-angle": 25,
        "text-padding": 6,
        "symbol-spacing": 260,
        "text-rotation-alignment": "map",
        "text-optional": true
      },
      "paint": {
        "text-color": "#8a6270",
        "text-halo-color": "#fffaf4",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "road-path", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 16.4,
      "filter": ["match", ["get", "class"], ["path", "track", "pedestrian"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:ja"], ["get", "name"], ["get", "name:en"], ""],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-padding": 4,
        "symbol-spacing": 220,
        "text-rotation-alignment": "map",
        "text-optional": true
      },
      "paint": {
        "text-color": "#7d8a62",
        "text-halo-color": "#fffaf4",
        "text-halo-width": 1.3,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "place-area", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["case",
          ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name:ja"], ["get", "name"], ""]]],
          ["concat", ["coalesce", ["get", "name:ja"], ["get", "name"]], "\n", ["get", "name:en"]],
          ["coalesce", ["get", "name:ja"], ["get", "name"], ""]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 12, 14, 16],
        "text-letter-spacing": 0.08,
        "text-padding": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#a06a78",
        "text-halo-color": "#fffaf4",
        "text-halo-width": 2,
        "text-halo-blur": 0.6
      }
    },
    {
      "id": "park-name", "type": "symbol", "source": "openmaptiles", "source-layer": "park",
      "minzoom": 13.5,
      "layout": {
        "text-field": ["case",
          ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name:ja"], ["get", "name"], ""]]],
          ["concat", ["coalesce", ["get", "name:ja"], ["get", "name"]], "\n", ["get", "name:en"]],
          ["coalesce", ["get", "name:ja"], ["get", "name"], ""]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 11, 16, 14],
        "text-padding": 6,
        "text-max-width": 8,
        "text-optional": true
      },
      "paint": {
        "text-color": "#4f7a52",
        "text-halo-color": "#f4fff4",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "station-name", "type": "symbol", "source": "openmaptiles", "source-layer": "poi",
      "minzoom": 14,
      "filter": ["all", ["==", ["get", "class"], "railway"], ["in", ["get", "subclass"], ["literal", ["station", "halt", "subway"]]]],
      "layout": {
        "text-field": ["case",
          ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name:ja"], ["get", "name"], ""]]],
          ["concat", ["coalesce", ["get", "name:ja"], ["get", "name"]], "  ", ["get", "name:en"]],
          ["coalesce", ["get", "name:ja"], ["get", "name"], ""]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-offset": [0, 0.6],
        "text-padding": 4,
        "text-optional": true
      },
      "paint": {
        "text-color": "#3d5c78",
        "text-halo-color": "#fffaf4",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ja"], ["get", "name"], ["get", "name:en"], ""],
        "text-font": ["Noto Sans Regular"],
        "text-size": 13,
        "symbol-placement": "line",
        "text-padding": 8,
        "text-optional": true
      },
      "paint": {
        "text-color": "#3d7ea8",
        "text-halo-color": "#f3fbff",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.3
      }
    }
  ]
}
