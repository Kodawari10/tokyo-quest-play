{
  "version": 8,
  "name": "Tokyo Quest Cartoon",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors © <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> © <a href=\"https://openfreemap.org\">OpenFreeMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#fff4ea" } },
    {
      "id": "residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#ffe8f0", "fill-opacity": 0.9 }
    },
    {
      "id": "wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#b7e7c8" }
    },
    {
      "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#9ed9b4" }
    },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#9fd4f2" }
    },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#7ec4ea",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 3, 18, 6]
      }
    },
    {
      "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "paint": { "fill-color": "#fff", "fill-outline-color": "#f3b7cc" }
    },
    {
      "id": "path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f3d2b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 17, 2.4]
      }
    },
    {
      "id": "minor-case", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f7c3d4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1.4, 16, 6, 18, 12]
      }
    },
    {
      "id": "minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fffaf6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.8, 16, 3.6, 18, 8]
      }
    },
    {
      "id": "major-case", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f28aaa",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2, 15, 8, 18, 16]
      }
    },
    {
      "id": "major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 15, 5, 18, 11]
      }
    },
    {
      "id": "motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe08a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.2, 14, 5, 17, 12]
      }
    },
    {
      "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#d7a8c4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 2.5],
        "line-dasharray": [2, 2]
      }
    }
  ]
}
